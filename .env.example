# huntley secrets. Copy to .env — which is gitignored.
#
# Nothing here is required to run `huntley daily --dry-run`: with
# email.provider: console the digest is written to data/digests/ instead of
# being sent, and Add links are simply omitted.

# ── Signing key for Add / APPROVE links ─────────────────────────────
#
# Shared between huntley and the Apps Script web app. Every action link is an
# HMAC over (action, id, expiry) under this key, so a link cannot be forged and
# a forwarded email stops working when it expires.
#
# Generate one:   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Paste the SAME value into the Apps Script's Script Properties.
HUNTLEY_LINK_SECRET=

# ── Email transport — set the ones your provider needs ──────────────

# provider: resend
RESEND_API_KEY=

# provider: mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=

# provider: smtp   (also: npm install nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── Google Sheets read-back (optional) ──────────────────────────────
#
# Only needed for `huntley sync`, which pulls your Add clicks back out of the
# sheet. Writing to the sheet never needs this — that goes through Apps Script.
# Either publish the sheet to the web and put the CSV URL here:
HUNTLEY_SHEET_CSV_URL=
# …or use a service account with read access to the sheet:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Overrides ───────────────────────────────────────────────────────

# console | resend | smtp | mailjet — overrides config, useful in cron
# HUNTLEY_EMAIL_PROVIDER=

# true forces the console transport regardless of config
# HUNTLEY_MOCK_EMAIL=false

# trace | debug | info | warn | error
# HUNTLEY_LOG_LEVEL=info

# DNS memoization / pacing for board HTTP (process-wide; default 1200 lookups/min)
# HUNTLEY_DNS_LOOKUPS_PER_MIN=1200
# HUNTLEY_NO_DNS_CACHE=1

# Self-hosted freehire instance
# FREEHIRE_API_URL=https://freehire.me
